{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "bracketSpacing": true,
  "arrowParens": "always",
  "objectWrap": "preserve",
  "endOfLine": "lf",
  "sortImports": {
    "groups": [["builtin", "external"], "parent", ["index", "sibling"]],
    "newlinesBetween": true,
    "order": "asc",
    "ignoreCase": true
  },
  "ignorePatterns": ["node_modules", "dist", "dist-electron", "out", "release", "pnpm-lock.yaml", "*.gen.*"]
}

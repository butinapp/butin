{
  "name": "@butinapp/ui",
  "version": "0.1.1",
  "description": "Butin's embeddable, theme-portable design system + the generic data-view renderer (DashboardRenderer, Overview, app shell). Pure, prop-driven, no Electron. Ships theme.css; a Tailwind host generates the utilities.",
  "homepage": "https://butin.app",
  "bugs": "https://github.com/butinapp/butin/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/butinapp/butin.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./primitives": "./src/primitives.ts",
    "./dashboard": "./src/dashboard.ts",
    "./shell": "./src/shell.ts",
    "./i18n": "./src/i18n/index.ts",
    "./theme.css": "./src/theme.css"
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./primitives": {
        "types": "./dist/primitives.d.ts",
        "import": "./dist/primitives.js"
      },
      "./dashboard": {
        "types": "./dist/dashboard.d.ts",
        "import": "./dist/dashboard.js"
      },
      "./shell": {
        "types": "./dist/shell.d.ts",
        "import": "./dist/shell.js"
      },
      "./i18n": {
        "types": "./dist/i18n/index.d.ts",
        "import": "./dist/i18n/index.js"
      },
      "./theme.css": "./dist/theme.css"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@butinapp/sdk": "workspace:*",
    "@butinapp/shapes": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lodash-es": "catalog:",
    "lucide-react": "catalog:",
    "luxon": "catalog:",
    "radix-ui": "^1.5.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/luxon": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}

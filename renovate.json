{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommits", "group:allNonMajor"],
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Auto-merge non-major devDependency bumps once CI is green and the release has aged past minimumReleaseAge.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Electron carries native/runtime risk — majors get a standalone PR for manual review.",
      "matchPackageNames": ["electron"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "groupName": null
    }
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict"
}
